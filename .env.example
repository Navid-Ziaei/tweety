# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# Pick ONE auth method.

# Target X account to scrape (handle without @)
TARGET=elonmusk

# --- Method 1: auth_token cookie (easiest) ---
# Log into x.com, DevTools > Application > Cookies > copy the `auth_token` value.
AUTH_TOKEN=

# --- Method 2: username + password ---
# May trigger 2FA/captcha (raises ActionRequired).
X_USER=
X_PASS=

PROXY_HOST=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_PORT=3128